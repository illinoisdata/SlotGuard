  "placement_capabilities": [
    {
      "placement": "harness",
      "observe_surface": [
        "prompt",
        "tool call",
        "tool output",
        "shell stdout/stderr",
        "process listing",
        "file content"
      ],
      "strengths": [
        "maximal provider-bound coverage",
        "can prevent downstream transcript accumulation",
        "can validate scope before local execution"
      ],
      "limitations": [
        "requires harness integration",
        "may be client-specific"
      ]
    },
    {
      "placement": "filesystem",
      "observe_surface": [
        "file paths",
        "directory listings",
        "file read results"
      ],
      "strengths": [
        "strong path/filename virtualization",
        "can validate local path scope"
      ],
      "limitations": [
        "cannot see prompt-only leaks",
        "cannot redact shell/process output"
      ]
    },
    {
      "placement": "gateway",
      "observe_surface": [
        "provider-bound prompt",
        "provider-bound tool output",
        "streamed transcript"
      ],
      "strengths": [
        "works across model backends",
        "easy to deploy as last-line defense"
      ],
      "limitations": [
        "cannot remove raw values already logged locally",
        "scope validation and rebinding are limited"
      ]
    }
  ]
